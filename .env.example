# ─── General ────────────────────────────────────────────────
APP_URL=http://localhost:3000
LOG_LEVEL=info

# DEMO_MODE=true habilita /demo, el reloj simulado y el reset de datos.
DEMO_MODE=true

# memory = datos seed en memoria (demo offline, sin Docker ni internet)
# supabase = Postgres real (local con `npx supabase start` o cloud en deploy)
DATA_BACKEND=memory
# sse = eventos en vivo por el servidor (un proceso); supabase = Supabase Realtime (producción, varias instancias)
NEXT_PUBLIC_LIVE_TRANSPORT=sse

# ─── Supabase (DATA_BACKEND=supabase) — fase D1 ─────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Zona horaria del salón (eventos de día completo del calendario externo)
SALON_TIMEZONE=America/Santo_Domingo

# ─── Lenguaje natural ───────────────────────────────────────
# rules = parser propio en español (gratis, offline)
# claude = parser propio + Claude como respaldo para mensajes ambiguos — fase D4
LLM_PROVIDER=rules
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS=8000
# Tope de consultas a Claude por día (guarda de gasto en código)
LLM_DAILY_LIMIT=300

# ─── Mensajería ─────────────────────────────────────────────
# simulator = teléfono simulado en /demo
# whatsapp = WhatsApp Cloud API de Meta — fase D2
MESSAGING_CHANNEL=simulator
# true = registra los envíos sin mandarlos
MESSAGING_DRY_RUN=false
WHATSAPP_API_VERSION=v23.0
# Número por defecto; cada salón tiene el suyo en salons.whatsapp_phone_number_id (npm run salon:create)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ─── Calendario ─────────────────────────────────────────────
# fake = calendario simulado en memoria
# google = Google Calendar con OAuth — fase D3
CALENDAR_PROVIDER=fake
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
GOOGLE_WEBHOOK_URL=

# ─── Jobs programados ───────────────────────────────────────
# Secreto que pg_cron / el scheduler envía en Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
