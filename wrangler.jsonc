{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slot-filler",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "slot-filler" }],
  // Variables no secretas. Los secretos se cargan con `npx wrangler secret put NOMBRE` (fase D1).
  "vars": {
    "DATA_BACKEND": "supabase",
    "DEMO_MODE": "false",
    "NEXT_PUBLIC_LIVE_TRANSPORT": "supabase",
    "MESSAGING_CHANNEL": "simulator",
    "CALENDAR_PROVIDER": "fake",
    "LLM_PROVIDER": "rules"
  }
}
